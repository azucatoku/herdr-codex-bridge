#!/usr/bin/env bash
# codex-bridge — ask the Codex running in a herdr pane, from Claude Code.
#
#   codex-bridge start [-m advisor|writer] [-d DIR] [-p PANE] [-M MODEL] [--replace]
#   codex-bridge ask   [-p PANE] [-t SEC] [-w SEC] "question"
#   codex-bridge list
#   codex-bridge --version
#
# stdout carries the answer only; stderr carries diagnostics. See README for exit codes.
set -uo pipefail

# Installed as a symlink, so resolve lib/ from the real path of this file.
CB_SELF=$(readlink -f "${BASH_SOURCE[0]}")
CB_ROOT=$(dirname "$(dirname "$CB_SELF")")
# shellcheck source=/dev/null
source "$CB_ROOT/lib/herdr.sh"
# shellcheck source=/dev/null
source "$CB_ROOT/lib/render.sh"
# shellcheck source=/dev/null
source "$CB_ROOT/lib/agent.sh"

E_OK=0 E_INTERNAL=1 E_USAGE=2 E_NOPANE=3 E_UNDELIVERED=4 E_BUSY=5 E_TIMEOUT=6

die() { echo "codex-bridge: $1" >&2; exit "${2:-$E_INTERNAL}"; }

# No second opinion is available. Tell an automated caller what to do next.
die_no_second_opinion() {
  echo "codex-bridge: $1" >&2
  echo "FALLBACK: proceed without a second opinion. You own the verdict." >&2
  exit "${2:-$E_NOPANE}"
}

# Require a value for an option. Without this, a missing value loops forever.
need() { [[ -n "${2:-}" && "$2" != -* ]] || die "$1 requires a value" $E_USAGE; }

 usage() { sed -n '3,8p' "$CB_SELF" | sed 's/^# \?//'; }

# Which build is running, and from where. An installed copy records the commit
# it was built from; a checkout reports its current state instead.
cmd_version() {
  [[ $# -gt 0 ]] && die "--version takes no arguments (got '$1')" $E_USAGE
  local ver="unknown" commit="" where=""
  [[ -r "$CB_ROOT/VERSION" ]] && ver=$(<"$CB_ROOT/VERSION")
  if [[ -r "$CB_ROOT/BUILD" ]]; then
    commit=$(<"$CB_ROOT/BUILD"); where="installed"
  elif git -C "$CB_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    commit=$(git -C "$CB_ROOT" describe --always --dirty --tags 2>/dev/null)
    where="development checkout"
  fi
  printf 'codex-bridge %s%s\n' "$ver" "${commit:+ ($commit)}"
  [[ -n "$where" ]] && printf '%s: %s\n' "$where" "$CB_ROOT"
  return $E_OK
}

cmd_list() {
  [[ $# -gt 0 ]] && die "list takes no arguments (got '$1')" $E_USAGE
  herdr::available || die "herdr not found" $E_INTERNAL
  local rows; rows=$(herdr::list_agents) || die "herdr agent list failed" $E_INTERNAL
  [[ -z "$rows" ]] && { echo "(no agents running)"; return 0; }
  printf '%-8s %-8s %-9s %s\n' PANE AGENT STATUS CWD
  printf '%s\n' "$rows" | while IFS=$'\t' read -r p a s c; do
    printf '%-8s %-8s %-9s %s\n' "$p" "$a" "$s" "$c"
  done
}

cmd_ask() {
  local pane="" timeout=300 busy=180
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p) need -p "${2:-}"; pane="$2"; shift 2 ;;
      -t) need -t "${2:-}"; timeout="$2"; shift 2 ;;
      -w) need -w "${2:-}"; busy="$2"; shift 2 ;;
      --) shift; break ;;
      -h|--help) usage; exit $E_OK ;;
      -*) die "unknown option '$1' (put a question starting with '-' after --)" $E_USAGE ;;
      *) break ;;
    esac
  done
  local q="${*:-}"
  [[ -z "$q" ]] && die "no question given" $E_USAGE
  [[ "$timeout" =~ ^[0-9]+$ && "$busy" =~ ^[0-9]+$ ]] || die "-t and -w take whole seconds" $E_USAGE
  herdr::available || die "herdr not found" $E_INTERNAL

  if [[ -z "$pane" ]]; then
    pane=$(herdr::find_agent codex) || die "herdr agent list failed" $E_INTERNAL
    [[ -z "$pane" ]] && die_no_second_opinion "no running codex pane found"
  else
    local kind
    kind=$(herdr::agent_kind "$pane") || die "herdr agent list query failed" $E_INTERNAL
    [[ -z "$kind" ]] && die_no_second_opinion "no agent running in $pane"
    # An agent being present is not enough: anything else means asking the wrong model.
    [[ "$kind" != "codex" ]] && die "$pane runs $kind, not codex" $E_NOPANE
  fi

  # One ask per pane at a time; concurrent asks would interleave observations.
  local ld="${XDG_RUNTIME_DIR:-/tmp}/codex-bridge"; mkdir -p "$ld" 2>/dev/null
  exec {lockfd}>"$ld/${pane//:/_}.lock" || die "could not create lock file" $E_INTERNAL
  if ! flock -w 5 "$lockfd"; then
    die "another ask is in progress on $pane" $E_BUSY
  fi

  agent::wait_idle "$pane" "$busy"
  case $? in
    5) die "$pane has been working for over ${busy}s; not interrupting it (raise with -w)" $E_BUSY ;;
    1) die "could not read the status of $pane" $E_INTERNAL ;;
  esac

  local marker; marker=$(agent::new_marker)
  agent::deliver "$pane" "$marker" "$q" \
    || die "could not confirm delivery to $pane. It may well have arrived — read the screen (herdr pane read $pane) before sending again" $E_UNDELIVERED

  agent::ensure_submitted "$pane" "$marker"

  local timed_out=0 wrc=0
  agent::wait_done "$pane" "$timeout" || wrc=$?
  case $wrc in
    0) ;;
    6) timed_out=1; echo "[codex-bridge] timed out after ${timeout}s — partial answer below" >&2 ;;
    *) die "status query failed while waiting for the answer" $E_INTERNAL ;;
  esac

  # The status can flip to idle before the text is flushed, so re-read a few
  # times rather than returning an empty answer as a success.
  local screen answer="" rc=1 lines
  for lines in 400 400 2000; do        # widen the window if long output pushed the marker out
    screen=$(herdr::pane_text "$pane" "$lines")
    answer=$(printf '%s\n' "$screen" | render::answer "$marker") && rc=0 || rc=1
    [[ "$rc" == 0 && -n "$answer" ]] && break
    cb::sleep 2
  done
  if (( rc != 0 )); then
    die "could not extract the answer (marker $marker not on screen)" $E_INTERNAL
  fi
  if [[ -z "$answer" ]]; then
    die "the answer has not arrived (marker present, body empty)" $E_TIMEOUT
  fi
  printf '%s\n' "$answer"
  (( timed_out )) && exit $E_TIMEOUT
  return $E_OK
}

cmd_start() {
  local mode=advisor dir="$PWD" pane="" model="" replace=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m) need -m "${2:-}"; mode="$2"; shift 2 ;;
      -d) need -d "${2:-}"; dir=$(cd "$2" 2>/dev/null && pwd) || die "no such directory: $2" $E_USAGE; shift 2 ;;
      -p) need -p "${2:-}"; pane="$2"; shift 2 ;;
      -M) need -M "${2:-}"; model="$2"; shift 2 ;;
      --replace) replace=1; shift ;;
      -h|--help) usage; exit $E_OK ;;
      *) die "unexpected argument '$1'" $E_USAGE ;;
    esac
  done
  local sandbox
  case "$mode" in
    advisor) sandbox=read-only ;;
    writer)  sandbox=workspace-write ;;
    *) die "unknown mode '$mode' (advisor|writer)" $E_USAGE ;;
  esac
  [[ -d "$dir" ]] || die "no such directory: $dir" $E_USAGE
  herdr::available || die "herdr not found" $E_INTERNAL
  command -v codex >/dev/null 2>&1 \
    || die_no_second_opinion "codex CLI not found (install it, then run codex login)"

  if [[ -z "$pane" ]]; then
    local cur; cur=$(herdr::pane_current)
    [[ -z "$cur" ]] && die "could not determine the current pane; name one with -p" $E_NOPANE
    pane=$(herdr::pane_split "$cur")
    [[ -z "$pane" ]] && die "could not split a new pane" $E_NOPANE
    echo "[codex-bridge] new pane $pane" >&2
  fi

  # With an agent already running, a command would be typed into its TUI rather
  # than the shell. Refuse by default so a live session is never destroyed.
  local running
  running=$(herdr::agent_kind "$pane") \
    || die "could not read the agent state of $pane; refusing to send blind" $E_INTERNAL
  if [[ -n "$running" ]]; then
    if (( ! replace )); then
      die "$pane already runs $running; pass --replace to replace it" $E_BUSY
    fi
    echo "[codex-bridge] stopping $running in $pane and replacing it" >&2
    local still=""
    for _ in 1 2 3; do
      herdr::send_key "$pane" C-c; cb::sleep 2
      still=$(herdr::agent_kind "$pane") \
        || die "could not read the agent state of $pane" $E_INTERNAL
      [[ -z "$still" ]] && break
    done
    [[ -n "$still" ]] && die "could not stop the agent already running in $pane" $E_INTERNAL
    cb::sleep 1
  fi

  # Clear the line: a terminal reply sequence left by Ctrl-C corrupts the next command.
  herdr::send_key "$pane" Enter; cb::sleep 1

  local cmd=(codex -s "$sandbox" -a never -C "$dir")
  [[ -n "$model" ]] && cmd+=(-m "$model")
  herdr::run "$pane" "${cmd[@]}"

  # Ready = the agent registered AND the input box is showing. We verified the
  # pane had no agent just before launching, so the registration is ours. (A
  # screen marker printed before launch is useless: codex uses the alt screen.)
  local out kind
  for _ in $(seq 1 25); do
    out=$(herdr::pane_text "$pane" 40)
    local errs
    errs=$(grep -E '^\s*Error|command not found|No such file or directory' <<<"$out" | head -3)
    if [[ -n "$errs" ]]; then
      { echo "codex-bridge: failed to start:"; printf '%s\n' "$errs"; } >&2
      exit $E_INTERNAL
    fi
    grep -qE 'Do you trust|trust the contents' <<<"$out" && herdr::send_key "$pane" Enter
    kind=$(herdr::agent_kind "$pane")
    if [[ "$kind" == "codex" ]] && grep -q 'Ask Codex' <<<"$out"; then
      echo "[codex-bridge] ready  pane=$pane  mode=$mode($sandbox)  dir=$dir" >&2
      echo "$pane"
      return $E_OK
    fi
    cb::sleep 3
  done
  die "did not become ready in time; check with: herdr pane read $pane" $E_TIMEOUT
}

# Called as ask-codex / start-codex, map to the matching subcommand.
case "$(basename "$0")" in
  ask-codex)   set -- ask "$@" ;;
  start-codex) set -- start "$@" ;;
esac

case "${1:-}" in
  start) shift; cmd_start "$@" ;;
  ask)   shift; cmd_ask   "$@" ;;
  list)  shift; cmd_list  "$@" ;;
  --version|-V) shift; cmd_version "$@" ;;
  -h|--help|"") usage ;;
  *) die "unknown command '$1'" $E_USAGE ;;
esac
